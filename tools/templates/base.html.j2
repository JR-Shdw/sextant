<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>sextant — {% block title %}{% endblock %}</title>
  <link rel="stylesheet" href="/static/style.css">
  <style>
    :root { --bg: #1a1a1a; --fg: #e0e0e0; --muted: #888; --accent: #6cf; --border: #333; --row-alt: #222; --danger: #f66; }
    * { box-sizing: border-box; }
    body { font-family: ui-sans-serif, system-ui, sans-serif; background: var(--bg); color: var(--fg); margin: 0; padding: 0 2rem 4rem; line-height: 1.5; }
    header { position: sticky; top: 0; background: var(--bg); border-bottom: 1px solid var(--border); padding: 1rem 0; margin-bottom: 1rem; z-index: 10; }
    header h1 { margin: 0 0 0.5rem; font-size: 1.2rem; }
    nav a { color: var(--accent); text-decoration: none; margin-right: 1rem; font-size: 0.9rem; }
    nav a:hover { text-decoration: underline; }
    section { margin: 2rem 0; }
    h2 { border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; font-size: 1.1rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; border: 1px solid var(--border); margin: 0.5rem 0 1.5rem; }
    th, td { text-align: left; padding: 0.5rem 0.75rem; border: 1px solid var(--border); vertical-align: top; }
    thead th { background: #262626; color: var(--fg); font-weight: 600; border-bottom: 2px solid var(--accent); text-transform: lowercase; letter-spacing: 0.04em; font-size: 0.82rem; }
    tbody tr:nth-child(even) { background: var(--row-alt); }
    tbody tr:hover { background: #2c2c2c; }
    code { font-family: ui-monospace, monospace; font-size: 0.85rem; color: var(--accent); }
    a { color: var(--accent); }
    p.empty { color: var(--muted); font-style: italic; }
    form.inline { display: inline; }
    button, .btn { background: transparent; color: var(--accent); border: 1px solid var(--border); padding: 0.3rem 0.6rem; cursor: pointer; font-family: inherit; font-size: 0.85rem; text-decoration: none; display: inline-block; margin: 0.1rem 0.1rem; }
    button:hover, .btn:hover { border-color: var(--accent); }
    button.danger, .btn.danger { color: var(--danger); }
    .btn.active { background: var(--accent); color: #000; border-color: var(--accent); }
    nav.filters { margin: 1rem 0; }
    form.filter-form { margin: 1rem 0; display: flex; gap: 0.5rem; align-items: center; }
    form.filter-form label { margin: 0; color: var(--muted); font-size: 0.85rem; }
    select { background: #0d0d0d; color: var(--fg); border: 1px solid var(--border); padding: 0.3rem 0.5rem; font-family: inherit; font-size: 0.9rem; min-width: 12rem; }
    ul.chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0; padding: 0; list-style: none; }
    ul.chips li { background: #2a2a2a; border: 1px solid var(--border); padding: 0.1rem 0.5rem; border-radius: 0.25rem; font-size: 0.78rem; color: var(--fg); }
    label { display: block; margin: 0.8rem 0 0.2rem; font-size: 0.85rem; color: var(--muted); }
    label .hint { color: var(--muted); font-style: italic; }
    input[type=text], input[type=number], textarea { width: 100%; background: #0d0d0d; color: var(--fg); border: 1px solid var(--border); padding: 0.4rem 0.6rem; font-family: ui-monospace, monospace; font-size: 0.9rem; }
    textarea { min-height: 60vh; }
    .actions { margin: 1rem 0; }
    .actions > * { margin-right: 0.5rem; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.8rem; }
  </style>
</head>
<body>
  <header>
    <h1>sextant</h1>
    <nav>
      <a href="/">Accueil</a>
      <a href="/catalog/projects">Projets</a>
      <a href="/catalog/forges">Forges</a>
      <a href="/catalog/nodes">Nodes</a>
      <a href="/catalog/vaults">Vaults</a>
      <a href="/files">Fichiers</a>
    </nav>
  </header>
  {% block content %}{% endblock %}
  <footer>sextant · CRUD local</footer>
</body>
</html>
