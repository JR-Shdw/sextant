{% extends "base.html.j2" %}
{% block title %}fichiers{% if current_project %} — {{ current_project }}{% endif %}{% endblock %}
{% block content %}
<section>
  <h2>
    Fichiers
    {% if current_project == "_system" %}— système{% elif current_project %}— {{ current_project }}{% else %}— global{% endif %}
    ({{ files|length }})
  </h2>

  <form method="get" action="/files" class="filter-form">
    <label for="proj-select">vue :</label>
    <select id="proj-select" name="project" onchange="this.form.submit()">
      <option value=""{% if not current_project %} selected{% endif %}>— global —</option>
      <option value="_system"{% if current_project == '_system' %} selected{% endif %}>système ({{ system_count }})</option>
      <optgroup label="projets">
        {% for p in available_projects %}
        <option value="{{ p }}"{% if current_project == p %} selected{% endif %}>{{ p }}</option>
        {% endfor %}
      </optgroup>
    </select>
    <noscript><button type="submit">filtrer</button></noscript>
  </form>

  {% if files %}
  <table>
    <thead><tr><th>path</th><th>projet</th><th>mots</th><th>~tok</th><th></th></tr></thead>
    <tbody>
      {% for f in files %}
      <tr>
        <td><code>{{ f.path }}</code></td>
        <td>{{ f.project_id or "—" }}</td>
        <td>{{ f.words if f.words is not none else "—" }}</td>
        <td>{{ f.tokens if f.tokens is not none else "—" }}</td>
        <td>
          {% if f.is_text %}<a href="/view?path={{ f.path }}" class="btn">view</a>{% endif %}
          {% if f.is_text %}<a href="/edit?path={{ f.path }}" class="btn">edit</a>{% endif %}
          <a href="/download?path={{ f.path }}" class="btn">dl</a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">Aucun fichier dans cette vue.</p>
  {% endif %}
</section>
{% endblock %}
